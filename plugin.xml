<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
      id="community-cordova-plugin-proguard"
      version="1.0.0">
    <name>Proguard</name>
    <description>Community Cordova ProGuard Plugin - Activates ProGuard and minification for Android builds</description>
    <license>MIT</license>
    <keywords>cordova,proguard,android,optimize,shrink,minify,obfuscate</keywords>
    <repo>https://github.com/EYALIN/community-cordova-plugin-proguard</repo>
    <issue>https://github.com/EYALIN/community-cordova-plugin-proguard/issues</issue>

    <platform name="android">
        <framework src="build.gradle" custom="true" type="gradleReference" />
        <asset src="proguard-custom.txt" target="proguard-custom.txt" />
        <hook type="before_plugin_install" src="scripts/androidBeforeInstall.js" />
    </platform>
</plugin>
